<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Animation.Design.BottomSheetDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/ai_rewrite_target_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:text="@string/ai_rewrite_title" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ai_rewrite_prompt_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ai_rewrite_prompt_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ai_rewrite_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:maxLines="5"
            android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/ai_rewrite_presets_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ai_rewrite_presets_label"
        android:textAppearance="?attr/textAppearanceTitleSmall" />

    <TextView
        android:id="@+id/ai_rewrite_presets_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ai_rewrite_presets_hint"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <TextView
        android:id="@+id/ai_rewrite_presets_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/ai_rewrite_presets_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/ai_rewrite_presets_scroll"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="6dp"
        android:fadeScrollbars="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/ai_rewrite_presets_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ai_rewrite_apply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        app:icon="@drawable/ic_lightbulb_stars"
        android:text="@string/ai_rewrite_apply" />
</LinearLayout>
